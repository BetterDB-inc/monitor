{
  "name": "@betterdb/ai",
  "version": "0.1.0",
  "description": "One install for the BetterDB AI stack on Valkey: agent cache, semantic cache, retrieval, agent memory, and search helpers",
  "keywords": [
    "valkey",
    "redis",
    "ai",
    "llm",
    "cache",
    "semantic-cache",
    "retrieval",
    "agent-memory",
    "vector-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterDB-inc/monitor",
    "directory": "packages/ai"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "require": "./dist/langchain.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph.d.ts",
      "import": "./dist/langgraph.js",
      "require": "./dist/langgraph.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js",
      "require": "./dist/vercel.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js",
      "require": "./dist/openai.js"
    },
    "./openai-responses": {
      "types": "./dist/openai-responses.d.ts",
      "import": "./dist/openai-responses.js",
      "require": "./dist/openai-responses.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.js"
    },
    "./llamaindex": {
      "types": "./dist/llamaindex.d.ts",
      "import": "./dist/llamaindex.js",
      "require": "./dist/llamaindex.js"
    },
    "./embed/openai": {
      "types": "./dist/embed/openai.d.ts",
      "import": "./dist/embed/openai.js",
      "require": "./dist/embed/openai.js"
    },
    "./embed/bedrock": {
      "types": "./dist/embed/bedrock.d.ts",
      "import": "./dist/embed/bedrock.js",
      "require": "./dist/embed/bedrock.js"
    },
    "./embed/voyage": {
      "types": "./dist/embed/voyage.d.ts",
      "import": "./dist/embed/voyage.js",
      "require": "./dist/embed/voyage.js"
    },
    "./embed/cohere": {
      "types": "./dist/embed/cohere.d.ts",
      "import": "./dist/embed/cohere.js",
      "require": "./dist/embed/cohere.js"
    },
    "./embed/ollama": {
      "types": "./dist/embed/ollama.d.ts",
      "import": "./dist/embed/ollama.js",
      "require": "./dist/embed/ollama.js"
    },
    "./embed/google": {
      "types": "./dist/embed/google.d.ts",
      "import": "./dist/embed/google.js",
      "require": "./dist/embed/google.js"
    }
  },
  "typesVersions": {
    "*": {
      "langchain": [
        "./dist/langchain.d.ts"
      ],
      "langgraph": [
        "./dist/langgraph.d.ts"
      ],
      "vercel": [
        "./dist/vercel.d.ts"
      ],
      "openai": [
        "./dist/openai.d.ts"
      ],
      "openai-responses": [
        "./dist/openai-responses.d.ts"
      ],
      "anthropic": [
        "./dist/anthropic.d.ts"
      ],
      "llamaindex": [
        "./dist/llamaindex.d.ts"
      ],
      "embed/openai": [
        "./dist/embed/openai.d.ts"
      ],
      "embed/bedrock": [
        "./dist/embed/bedrock.d.ts"
      ],
      "embed/voyage": [
        "./dist/embed/voyage.d.ts"
      ],
      "embed/cohere": [
        "./dist/embed/cohere.d.ts"
      ],
      "embed/ollama": [
        "./dist/embed/ollama.d.ts"
      ],
      "embed/google": [
        "./dist/embed/google.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@betterdb/agent-cache": "workspace:*",
    "@betterdb/agent-memory": "workspace:*",
    "@betterdb/retrieval": "workspace:*",
    "@betterdb/semantic-cache": "workspace:*",
    "@betterdb/valkey-search-kit": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.90.0",
    "@langchain/core": ">=0.3.0",
    "@langchain/langgraph-checkpoint": ">=0.1.0",
    "@llamaindex/core": ">=0.6.0",
    "ai": "^6.0.135",
    "iovalkey": ">=0.3.0",
    "openai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint": {
      "optional": true
    },
    "@llamaindex/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@langchain/core": "^1.1.35",
    "@langchain/langgraph-checkpoint": "^0.1.0",
    "@llamaindex/core": "^0.6.23",
    "@types/node": "^22.19.15",
    "ai": "^6.0.135",
    "iovalkey": ">=0.3.0",
    "openai": "^6.34.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://betterdb.com"
}
