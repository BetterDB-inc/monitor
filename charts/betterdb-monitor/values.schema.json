{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "betterdb-monitor values",
  "description": "Values for the BetterDB Monitor Helm chart.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of pods. Keep at 1 unless storage.type=postgres."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": {
          "type": "string",
          "description": "Empty resolves to <appVersion>-no-ai (the standard image)."
        },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "db": {
      "type": "object",
      "description": "The Valkey/Redis instance to monitor.",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "type": { "type": "string", "enum": ["auto", "valkey", "redis"] },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "description": "Where the monitor persists its own history.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["memory", "postgres", "postgresql"],
          "description": "memory is ephemeral; postgres needs url or existingSecret."
        },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "offline": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      }
    },
    "telemetry": { "type": "boolean" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
