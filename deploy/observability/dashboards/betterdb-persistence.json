{
  "uid": "betterdb-persistence",
  "title": "BetterDB \u00b7 Persistence",
  "tags": [
    "betterdb",
    "valkey"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "ds",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "betterdb",
          "value": "betterdb"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(betterdb_memory_used_bytes, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Scrape job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": {
          "query": "label_values(betterdb_memory_used_bytes, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "name": "connection",
        "label": "Connection",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(betterdb_memory_used_bytes{job=~\"$job\"}, connection)",
          "refId": "connection"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Changes since last RDB save",
      "description": "Writes accumulated since the last successful RDB snapshot. A number that keeps climbing without resetting means snapshots are not completing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "betterdb_rdb_changes_since_last_save{job=~\"$job\",connection=~\"$connection\"}",
          "legendFormat": "{{connection}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time since last RDB save",
      "description": "Seconds since the last successful RDB save. A sawtooth that climbs without dropping means save is failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "time() - betterdb_rdb_last_save_timestamp_seconds{job=~\"$job\",connection=~\"$connection\"}",
          "legendFormat": "{{connection}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RDB last bgsave OK",
      "description": "1 when the most recent background RDB save succeeded, 0 on failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "betterdb_rdb_last_bgsave_ok{job=~\"$job\",connection=~\"$connection\"}",
          "legendFormat": "{{connection}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AOF enabled",
      "description": "1 when append-only file persistence is enabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "betterdb_aof_enabled{job=~\"$job\",connection=~\"$connection\"}",
          "legendFormat": "{{connection}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "AOF last rewrite OK",
      "description": "1 when the most recent AOF rewrite succeeded, 0 on failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "betterdb_aof_last_bgrewrite_ok{job=~\"$job\",connection=~\"$connection\"}",
          "legendFormat": "{{connection}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    }
  ],
  "links": [
    {
      "title": "BetterDB dashboards",
      "type": "dashboards",
      "tags": [
        "betterdb"
      ],
      "asDropdown": true,
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "keepTags": false
    }
  ]
}