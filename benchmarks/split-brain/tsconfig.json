{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["../../apps/api/src/*"],
      "@proprietary/*": ["../../proprietary/*"],
      "@betterdb/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
