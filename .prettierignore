# Dependencies and build outputs
node_modules
dist
build
coverage
.next
.turbo/
*.tsbuildinfo

# Lockfiles are owned by the package manager, not the formatter
pnpm-lock.yaml
package-lock.json
yarn.lock

# Runtime data (sqlite, indexed docs, vector stores) — never source.
apps/api/data/
*.db
*.db-shm
*.db-wal
# *.lance also matches LanceDB *.lance/ directories.
*.lance

# Test fixtures are data, not code style
**/__tests__/fixtures/
**/test/fixtures/

# Helm chart templates contain Go templating, not plain YAML.
charts/**/templates/

# Regenerated by `helm repo index` — formatting it is churn
docs/charts/index.yaml

# Docs are not code style. YAML/JSON stay eligible so workflows,
# actions, and package.json are still checked when explicitly supplied.
*.md
docs/
examples/
openapi/
